@using Sandbox;
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent
@using System;
@using Sandbox.Data

<root class="@(IsOpen ? "" : "hidden")">
	@if (IsOpen && GetPlayerData() != null)
	{
		<div class="wrapper">
			<header>
				<div class="header-left">PRESTIGE UPGRADES</div>
				<div class="header-right">
					<div class="skill-points-info">
						<span>AVAILABLE SKILL POINTS</span>
						<div class="skill-points-amount">
							<span>@Data.GetPrestigeSkillPoints()</span>
						</div>
					</div>
					<div class="close-btn" @onclick=@CloseMenu>X</div>
				</div>
			</header>
			<div class="canvas-container">
				<div class="canvas-bg" @onmousedown=@OnMouseDragged @onmouseup=@OnMouseReleased></div>
				<div class="canvas" style="transform: translate(@(CanvasX)px, @(CanvasY)px) scale(@Scale);">
					<!-- Lines -->
					<div class="lines">
						@foreach (PrestigeUpgrade Upgrade in PrestigeUpgrades)
						{
							bool IsUpgradeOwned = GetIsOwned(Upgrade.Name);
							bool IsAvailable = GetIsAvailable(Upgrade.Name);
							bool IsDiscoverable = !IsUpgradeOwned && Upgrade.ParentsUpgradeNames.Any(GetIsAvailable);
							if (!IsUpgradeOwned && !IsAvailable && !IsDiscoverable) continue;
							@foreach (EPrestigeUpgradeName ParentId in Upgrade.ParentsUpgradeNames)
							{
								PrestigeUpgrade Parent = PrestigeUpgrades.FirstOrDefault(U => U.Name == ParentId);
								if (Parent == null) continue;
								float Dx = Upgrade.X - Parent.X;
								float Dy = Upgrade.Y - Parent.Y;
								float Length = MathF.Sqrt(Dx * Dx + Dy * Dy);
								float Angle = MathF.Atan2(Dy, Dx) * 180f / MathF.PI;
								bool IsOwnedPath = IsUpgradeOwned && GetIsOwned(Parent.Name);
								<div class="line @(IsOwnedPath ? "owned" : "unowned")" style="left: @(Parent.X + 32)px; top: @(Parent.Y + 32)px; width: @(Length)px; transform: rotate(@(Angle)deg);"></div>
							}
						}
					</div>
					<!-- Upgrade Nodes -->
					<div class="nodes">
						@foreach (PrestigeUpgrade Upgrade in PrestigeUpgrades)
						{
							bool IsUpgradeOwned = GetIsOwned(Upgrade.Name);
							bool IsAvailable = GetIsAvailable(Upgrade.Name);
							bool IsDiscoverable = !IsUpgradeOwned && !IsAvailable && Upgrade.ParentsUpgradeNames.Any(GetIsAvailable);
							if (!IsAvailable && !IsDiscoverable) continue;
							bool IsSelected = SelectedUpgradeName == Upgrade.Name;
							string BackgroundStyle = "background-color: black;";
							if (!IsDiscoverable)
							{
								if (!CanBuyMore(Upgrade)) BackgroundStyle = "background-color: #FFFF00BF;";
								else if (CanAfford(Upgrade)) BackgroundStyle = "background-color: #41D34D;";
								else BackgroundStyle = "background-color: #C92121;";
							}
							<div class="node-wrapper @(IsSelected ? "selected" : "")" style="left: @(Upgrade.X)px; top: @(Upgrade.Y)px;"
							     @onclick=@(IsDiscoverable ? null : () => SelectUpgrade(Upgrade.Name))>
								<div class="node @(IsUpgradeOwned ? "owned" : "") @(IsAvailable ? "available" : "locked")" style="@BackgroundStyle">
									<img src="@(IsDiscoverable ? QuestionMarkIcon : Upgrade.Icon)" alt=""/>
									@if (Upgrade.MaxAmount > 1 && IsAvailable)
									{
										<div class="level-badge">@GetLevel(Upgrade.Name)/@Upgrade.MaxAmount</div>
									}
									@if (IsUpgradeOwned && GetLevel(Upgrade.Name) == Upgrade.MaxAmount)
									{
										<div class="check"><i>check</i></div>
									}
								</div>
							</div>
						}
					</div>
				</div>
				<!-- Zoom Controls -->
				<div class="zoom-controls" @onwheel="OnMouseWheel">
					<div class="btn" @onclick=@ZoomIn><i>add</i></div>
					<div class="btn" @onclick=@ZoomOut><i>remove</i></div>
					<div class="btn zoom-scale">@Scale.ToString("F1")x</div>
					<div class="btn" @onclick=@ZoomDefault><i>home</i></div>
				</div>
				<!-- Sidebar Info -->
				@if (SelectedUpgrade != null)
				{
					<div class="sidebar">
						<div class="close-sidebar" @onclick=@(() => { SelectedUpgradeName = EPrestigeUpgradeName.None; })>X</div>
						<h2>@SelectedUpgrade.Title</h2>
						<p class="desc">@GetDynamicDescription(SelectedUpgrade)</p>
						@if (SelectedUpgrade.Value != EPrestigeUpgradeValue.None)
						{
							<div class="stat-row">
								<span>CURRENT VALUE</span>
								<span class="text-yellow">@GetFormattedUpgradeValue(SelectedUpgrade.Value)</span>
							</div>
						}
						@if (CanBuyMore(SelectedUpgrade))
						{
							<div class="stat-row">
								<span>UPGRADE COST</span>
								<span class="@(CanAfford(SelectedUpgrade) ? "text-green" : "text-red")">@GetCurrentCost(SelectedUpgrade)</span>
							</div>
						}
						<div class="stat-row">
							<span>LEVEL</span>
							<span class="text-yellow">@GetLevel(SelectedUpgradeName) / @SelectedUpgrade.MaxAmount</span>
						</div>
						<div class="buy-section">
							@if (!CanBuyMore(SelectedUpgrade))
							{
								<div class="buy-btn maxed">MAXED OUT</div>
							}
							else
							{
								<div class="buy-btn @(CanAfford(SelectedUpgrade) && GetIsAvailable(SelectedUpgradeName) ? "active" : "disabled")" @onclick=@BuyUpgrade>
									@(!GetIsAvailable(SelectedUpgradeName) ? "LOCKED" : CanAfford(SelectedUpgrade) ? "BUY UPGRADE" : "NEED MORE SKILL POINTS")
								</div>
							}
						</div>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	[Property, ImageAssetPath] private string QuestionMarkIcon { get; set; }
	private bool IsOpen;
	private bool IsDragging;
    private EPrestigeUpgradeName SelectedUpgradeName;
    private float CanvasX = -225f;
    private float CanvasY;
    private float Scale = 1f;
    private Vector2 DragStartPos;
    private Vector2 DragStartOffset;
    private PlayerData Data;
    private List<PrestigeUpgrade> PrestigeUpgrades;
	// --------------------------------------------------------------PROTECTED METHODS--------------------------------------------------------------
    protected override void OnMouseWheel(Vector2 InValue)
    {
	    if (InValue.y < 0) Scale = Math.Min(Scale + 0.2f, 2.4f);
	    else if (InValue.y > 0) Scale = Math.Max(Scale - 0.2f, 0.6f);
    }
    protected override void OnAwake()
    {
	    EventManager.OnUiStateChanged += UiStateChanged;
	    EventManager.OnPrestigeUpgradePurchased += OnPrestigeUpgradePurchased;
    }
    protected override void OnStart()
    {
	    PrestigeUpgrades = GlobalData.Instance.GetPrestigeUpgrades();
	    CalculatePurchasableUpgrades();
    }
    protected override void OnDestroy()
    {
	    EventManager.OnUiStateChanged -= UiStateChanged;
	    EventManager.OnPrestigeUpgradePurchased -= OnPrestigeUpgradePurchased;
    }
    protected override int BuildHash()
    {
	    if (Data?.GetOwnedPrestigeUpgrades() == null) return -1;
	    return HashCode.Combine(Data.GetPrestigeSkillPoints(), SelectedUpgradeName, Scale, CanvasX, CanvasY, Data.GetOwnedPrestigeUpgrades().Count, IsDragging, IsOpen);
    }
    protected override void OnUpdate()
    {
	    if (!IsDragging) return;
	    Vector2 Delta = Mouse.Position - DragStartPos;
	    CanvasX = DragStartOffset.x + Delta.x / Scale;
	    CanvasY = DragStartOffset.y + Delta.y / Scale;
    }
	// --------------------------------------------------------------PRIVATE METHODS--------------------------------------------------------------
	private bool CanAfford(PrestigeUpgrade InUpgrade)
	{
		return InUpgrade != null && Data.GetPrestigeSkillPoints() >= GetCurrentCost(InUpgrade);
	}
	private PrestigeUpgrade SelectedUpgrade => PrestigeUpgrades.FirstOrDefault(U => U.Name == SelectedUpgradeName);
	private bool GetIsAvailable(EPrestigeUpgradeName InUpgradeName)
	{
		PrestigeUpgrade Upgrade = PrestigeUpgrades.FirstOrDefault(U => U.Name == InUpgradeName);
		if (Upgrade == null) return false;
		return Upgrade.ParentsUpgradeNames.Count == 0 || Upgrade.ParentsUpgradeNames.All(GetIsOwned);
	}
	private bool GetIsOwned(EPrestigeUpgradeName InUpgradeName) => GetLevel(InUpgradeName) > 0;
	private bool CanBuyMore(PrestigeUpgrade InUpgrade) 
	{
		return InUpgrade != null && GetLevel(InUpgrade.Name) < InUpgrade.MaxAmount;
	}
	private int GetLevel(EPrestigeUpgradeName InUpgradeName) => Data.GetOwnedPrestigeUpgrades().GetValueOrDefault(InUpgradeName, 0);
	private int GetCurrentCost(PrestigeUpgrade InUpgrade)
	{
		if (InUpgrade?.Costs == null || InUpgrade.Costs.Count == 0) return 0;
		int CurrentLevel = GetLevel(InUpgrade.Name);
		return CurrentLevel >= InUpgrade.MaxAmount ? InUpgrade.Costs.Last() : InUpgrade.Costs[CurrentLevel];
	}
	private float GetUpgradeValue(EPrestigeUpgradeValue InUpgradeValue)
	{
		if (Data == null) return 0f;
		GlobalData GlobalInstance = GlobalData.Instance;
		switch (InUpgradeValue)
		{
			case EPrestigeUpgradeValue.MovementMaxLimit: return GlobalInstance.GetDefaultAttributeValue(EDefaultAttribute.MovementSpeedMaxLimit) + Data.GetPrestigeUpgradeValueAmount(EPrestigeUpgradeName.MovementMaxLimit1);
			case EPrestigeUpgradeValue.BagMaxLimit: return GlobalInstance.GetDefaultAttributeValue(EDefaultAttribute.BagMaxLimit) + Data.GetPrestigeUpgradeValueAmount(EPrestigeUpgradeName.BagMaxLimit1);
			default: return 0;
		}
	}
	private string GetFormattedUpgradeValue(EPrestigeUpgradeValue InUpgradeValue)
	{
		float Value = GetUpgradeValue(InUpgradeValue);
		string Formatted = Value.ToString("0.##");
		switch (InUpgradeValue)
		{
		//	case EUpgradeValue.DashCooldown: case EUpgradeValue.DashCooldownReductionPerBox: return $"{Formatted}s";
			case EPrestigeUpgradeValue.MovementMaxLimit: case EPrestigeUpgradeValue.BagMaxLimit: return Formatted;
			default: return $"{Formatted}%";
		}
	}
	private string GetDynamicDescription(PrestigeUpgrade InUpgrade)
	{
		return InUpgrade == null ? "" : InUpgrade.Description
			.Replace("{0}", GlobalData.Instance.GetUpgradeValue(InUpgrade.Name).ToString("G"))
			.Replace("{1}", GlobalData.Instance.GetDefaultAttributeValue(InUpgrade.DefaultAttribute).ToString("G"));
	}
	private PlayerData GetPlayerData()
	{
		Data ??= PlayerSaveManager.Instance.Data;
		return Data;
	}

	private void OnPrestigeUpgradePurchased(EPrestigeUpgradeName InPrestigeUpgradeName) { CalculatePurchasableUpgrades(); }
	private void CalculatePurchasableUpgrades()
	{
		if (GetPlayerData() == null) return;
		int PurchasableCount = 0;
		foreach (PrestigeUpgrade Upgrade in PrestigeUpgrades)
		{
			if (Upgrade == null) continue;
			if (GetIsAvailable(Upgrade.Name) && CanBuyMore(Upgrade) && CanAfford(Upgrade)) PurchasableCount++;
		}
		EventManager.TriggerUpgradesAvailableToBePurchased(PurchasableCount);
	}
	private void OnMouseDragged()
	{
		IsDragging = true;
		DragStartPos = Mouse.Position;
		DragStartOffset = new Vector2(CanvasX, CanvasY);
	}
	private void ZoomIn()
	{
		Scale = Math.Min(Scale + 0.2f, 3f);
		SoundManager.Instance?.Play2D(ESound.UpgradeNodeClick);
	}
	private void ZoomOut()
	{
		Scale = Math.Max(Scale - 0.2f, 0.6f);
		SoundManager.Instance?.Play2D(ESound.UpgradeNodeClick);
	}
	private void ZoomDefault()
	{
		CanvasX = -225f;
		CanvasY = 0f;
		Scale = 1f;
		SoundManager.Instance?.Play2D(ESound.UpgradeNodeClick);
	}
	private void OnMouseReleased() { IsDragging = false; }
	private void SelectUpgrade(EPrestigeUpgradeName InUpgradeName)
	{
		SelectedUpgradeName = InUpgradeName;
		SoundManager.Instance?.Play2D(ESound.UpgradeNodeClick);
	}
	private void BuyUpgrade()
	{
		if (SelectedUpgradeName == EPrestigeUpgradeName.None || SelectedUpgrade == null || !CanBuyMore(SelectedUpgrade) || !CanAfford(SelectedUpgrade) || !GetIsAvailable(SelectedUpgradeName)) return;
		Data.BuyPrestigeUpgrade(SelectedUpgradeName);
		SoundManager.Instance?.Play2D(ESound.BuyUpgrade);
		CalculatePurchasableUpgrades();
	}
	private void CloseMenu() { UiManager.ChangeUiState(EUi.PrestigeUpgrades); }
	private void UiStateChanged(EUi InUi, bool RenderState)
	{
		if (InUi != EUi.PrestigeUpgrades) return;
		IsOpen = RenderState;
		Panel?.Style.PointerEvents = IsOpen ? PointerEvents.All : PointerEvents.None;
	}
}
