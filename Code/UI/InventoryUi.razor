@inherits PanelComponent
@using System
@using Sandbox.Data
@using Sandbox.Enums
@using Sandbox.Managers

<root class="@(IsOpen ? "" : "hidden")">
	@if (IsOpen && GetPlayerData() != null)
	{
		<div class="inventory-window">
			<div class="tabs-header">
				<div class="tab-button @(ActiveTab == 0 ? "active" : "")" onclick="@(() => SetActiveTab(0))">TOOLS</div>
				<div class="close-btn" @onclick=@CloseMenu>X</div>
			</div>
			<div class="main-split-container">
				@if (ActiveTab == 0)
				{
					<div class="items-grid-panel @(ToolData.Count > 24 ? "can-scroll" : "")">
						@foreach (KeyValuePair<ETool, ToolData> Tool in ToolData)
						{
							<div class="grid-slot @(Tool.Key == SelectedTool ? "selected" : "")" onclick="@(() => SelectItem(Tool.Key))">
								<div class="slot-content">
									<i class="item-icon">handyman</i>
								</div>
							</div>
						}
					</div>
					<div class="details-inspector-panel">
						<div class="inspector-header">
							<span class="item-title">@SelectedTool.GetDisplayName()</span>
						</div>
						<div class="slot-selector-wrapper">
							<label class="dropdown-label">CHOOSE HOTBAR SLOT:</label>
							<div class="custom-dropdown-header" onclick="@ToggleDropdown">
								<span>@Data.GetToolSlot(SelectedTool)</span>
								<div class="arrow">▼</div>
							</div>
							@if (IsDropdownOpen)
							{
								<div class="custom-dropdown-list">
									@for (int Index = 0; Index < 10; Index++)
									{
										int CurrentIndex = Index;
										<div class="custom-option @(SelectedEquipSlot == CurrentIndex ? "active" : "")" onclick="@(() => SelectSlot(CurrentIndex))">@CurrentIndex</div>
									}
								</div>
							}
						</div>
						<div class="equip-btn" onclick="@EquipTool">EQUIP</div>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	private bool IsOpen;
	private bool IsDropdownOpen;
	private int ActiveTab;
	private int SelectedEquipSlot;
	private ETool SelectedTool;
	private PlayerData Data;
	private Dictionary<ETool, ToolData> ToolData;
	
	protected override int BuildHash()
	{
		return HashCode.Combine(IsOpen, ActiveTab, SelectedTool);
	}
	
	protected override void OnAwake()
	{
		ToolData = GlobalData.Instance.GetToolsInformation();
		EventManager.OnUiStateChanged += UiStateChanged;
	}
	protected override void OnDestroy()
	{
		EventManager.OnUiStateChanged -= UiStateChanged;
	}
	
	private PlayerData GetPlayerData()
	{
		Data ??= PlayerSaveManager.Instance.Data;
		return Data;
	}
	
	private void ToggleDropdown() { IsDropdownOpen = !IsDropdownOpen; }
	private void SetActiveTab(int InTabId) { ActiveTab = InTabId; }
	private void SelectItem(ETool InTool) { SelectedTool = InTool; }
	private void SelectSlot(int InIndex)
	{
		SelectedEquipSlot = InIndex;
		IsDropdownOpen = false;
		Data.SetToolHotbarSlot(SelectedTool, InIndex);
	}
	private void EquipTool()
	{
		
	}
	private void CloseMenu() { UiManager.ChangeUiState(EUi.Inventory); }
	private void UiStateChanged(EUi InUi, bool RenderState)
	{
		if (InUi != EUi.Inventory) return;
		IsOpen = RenderState;
		Panel?.Style.PointerEvents = IsOpen ? PointerEvents.All : PointerEvents.None;
	}
}
