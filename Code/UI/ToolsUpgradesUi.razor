@using Sandbox.Data
@using Sandbox.Enums
@using Sandbox.Managers
@inherits PanelComponent
@using System;

<root class="@(IsOpen ? "" : "hidden")">
    @if (IsOpen && GetPlayerData() != null)
    {
	    <div class="shop-container">
		    <div class="shop-header">
			    <span class="shop-title">TOOLS</span>
		    </div>
		    <div class="shop-body">
			    <div class="left-panel">
				    <div class="money-card">
					    <span class="money-label">Money Amount</span>
					    <span class="money-amount">$@Data.Money.ToString("N0")</span>
				    </div>
				    <div class="tools-list">
					    @foreach (KeyValuePair<ETool, ToolData> Tool in ToolsData)
					    {
						    bool IsSelected = SelectedTool == Tool.Key;
						    bool IsToolUnlocked = Data.IsToolUnlocked(Tool.Key);
						    <div class="tool-item @(IsSelected ? "selected" : "")" onclick="@(() => SelectTool(Tool.Key, IsToolUnlocked))">
							    <img class="tool-icon" alt="" src="@Tool.Value.Icon"/>
							    <div class="tool-meta">
								    <span class="tool-name">@(IsToolUnlocked ? Tool.Value.ToolName.GetDisplayName() : "???")</span>
							    </div>
							    @if (!IsToolUnlocked)
							    {
								    <i class="lock-icon">lock</i>
							    }
						    </div>
					    }
				    </div>
			    </div>
			    <div class="right-panel">
				    <div class="close-btn" @onclick=@CloseMenu>X</div>
				    @if (ToolsData.TryGetValue(SelectedTool, out ToolData CurrentTool))
				    {
					    bool IsToolUnlocked = Data.IsToolUnlocked(SelectedTool);
					    <div class="tool-showcase-header">
						    <img class="showcase-icon" alt="" src="@CurrentTool.Icon"/>
						    <span class="showcase-name">@(IsToolUnlocked ? CurrentTool.ToolName.GetDisplayName() : "???")</span>
					    </div>
					    <div class="upgrades-list @(IsToolUnlocked ? "" : "blurred-lock")">
						    @foreach (KeyValuePair<EToolStat, ToolUpgradeData> Upgrade in CurrentTool.Upgrades)
						    {
							    int CurrentStatLevel = Data.GetToolStatLevel(SelectedTool, Upgrade.Key);
							    bool IsMaxed = CurrentStatLevel >= Upgrade.Value.MaxLevel;
							    <div class="upgrade-row">
								    <div class="upgrade-info">
									    <div class="upgrade-row-header">
										    <img class="stat-icon" src="@Upgrade.Value.Icon" alt=""/>
										    <span class="stat-name">@Upgrade.Value.ToolStat.GetDisplayName()</span>
										    <span class="stat-desc-previous">@GetCurrentDescription(CurrentStatLevel, Upgrade.Value)</span>
										    @if (!IsMaxed)
										    {
											    <span>-></span>
											    <span class="stat-desc-next">@GetNextDescription(CurrentStatLevel, Upgrade.Value)</span>
										    }
									    </div>
								    </div>
								    <div class="pips-wrapper">
									    @for (int Index = 0; Index < Upgrade.Value.MaxLevel; Index++)
									    {
										    <div class="pip @(Index < CurrentStatLevel ? "filled" : "")"></div>
									    }
								    </div>
								    @if (IsMaxed)
								    {
									    <div class="buy-btn maxed" disabled>MAX</div>
								    }
								    else
								    {
									    int Price = Upgrade.Value.Prices[CurrentStatLevel];
									    <div class="buy-btn @(Data.Money >= Price ? "" : "cant-afford")" onclick="@(() => PurchaseUpgrade(Upgrade.Key, Price))">$@Price.ToString("N0")</div>
								    }
							    </div>
						    }
					    </div>
					    @if (!IsToolUnlocked)
					    {
						    <div class="unlock-overlay">
							    <div class="unlock-btn @(Data.Money >= CurrentTool.UnlockPrice ? "" : "cant-afford")" @onclick=@(() => UnlockTool(SelectedTool, CurrentTool.UnlockPrice))>UNLOCK @CurrentTool.UnlockPrice.ToString("N0")$</div>
						    </div>
					    }
				    }
			    </div>
			    @if (ToolsData.TryGetValue(SelectedTool, out ToolData CurrentToolData))
			    {
				    <div class="info-showcase-panel">
					    <div class="showcase-title-area">
						    <span class="meta-tool-name">@(Data.IsToolUnlocked(SelectedTool) ? CurrentToolData.ToolName.GetDisplayName() : "???")</span>
					    </div>
					    <div class="stats-overview-box">
						    <span class="overview-header">Default Tool Stats</span>
						    <div class="meta-stat-row">
							    <span class="meta-stat-label">POWER</span>
							    <span class="meta-stat-value">@CurrentToolData.Power</span>
						    </div>
						    <div class="meta-stat-row">
							    <span class="meta-stat-label">RANGE</span>
							    <span class="meta-stat-value">@CurrentToolData.Range</span>
						    </div>
						    <div class="meta-stat-row">
							    <span class="meta-stat-label">COLLECT COOLDOWN</span>
							    <span class="meta-stat-value">@CurrentToolData.CollectCooldown s</span>
						    </div>
					    </div>
					    @if (Data.HasAtLeastOneToolUpgrade(SelectedTool))
					    {
						    <div class="stats-overview-box">
							    <span class="overview-header">Upgraded Tool Stats</span>
							    @foreach (KeyValuePair<EToolStat, ToolUpgradeData> Upgrade in CurrentToolData.Upgrades)
							    {
								    <div class="meta-stat-row">
									    <span class="meta-stat-label">@Upgrade.Value.ToolStat.GetDisplayName()</span>
									    <span class="meta-stat-value">@GetUpgradedToolValue(Upgrade.Key)</span>
								    </div>
							    }
						    </div>
					    }
				    </div>
			    }
		    </div>
	    </div>
    }
</root>

@code
{
    private bool IsOpen;
    private ETool SelectedTool;
    private PlayerData Data;
    private Dictionary<ETool, ToolData> ToolsData;

    protected override int BuildHash()
    {
	    if (GetPlayerData() == null) return -1;
        return HashCode.Combine(IsOpen, Data.Money, SelectedTool);
    }
    
    protected override void OnAwake()
    {
        EventManager.OnUiStateChanged += UiStateChanged;
    }
    protected override void OnStart()
    {
	    ToolsData = GlobalData.Instance.GetToolsInformation();
	    SelectedTool = GetPlayerData()?.EquippedTool ?? ETool.Hands;
    }
    protected override void OnDestroy()
    {
        EventManager.OnUiStateChanged -= UiStateChanged;
    }

	private string GetUpgradedToolValue(EToolStat InToolStat)
	{
		ETool EquippedTool = Data.GetEquippedTool();
		ToolData EquippedToolData = GlobalData.Instance.GetToolData(EquippedTool);
		int CurrentLevel = Data.GetToolStatLevel(EquippedTool, InToolStat);
		float StatValue = EquippedToolData.GetToolStatValue(InToolStat);
		float AdditiveBonus = CurrentLevel * StatValue;
		float Multiplier = 1f + AdditiveBonus * 0.01f;
		switch (InToolStat)
		{
			case EToolStat.Power: return (EquippedToolData.Power + (int)AdditiveBonus).ToString();
			case EToolStat.Range: return (EquippedToolData.Range * Multiplier).ToString("0.##");
			case EToolStat.Speed: return (EquippedToolData.CollectCooldown / Multiplier).ToString("0.##") + " s";
		}
		return "";
	}
    private string GetCurrentDescription(int InCurrentLevel, ToolUpgradeData InToolUpgrade)
    {
	    if (InToolUpgrade == null) return "";
	    if (InCurrentLevel == 0) return "None"; 
	    float CurrentValue = InToolUpgrade.Value * InCurrentLevel;
	    switch (InToolUpgrade.ToolStat)
	    {
		    case EToolStat.Power: return "+" + InToolUpgrade.Description.Replace("{0}", CurrentValue.ToString("G"));
		    default: return InToolUpgrade.Description.Replace("{0}", CurrentValue.ToString("G"));
	    }
    }
    private string GetNextDescription(int InCurrentLevel, ToolUpgradeData InToolUpgrade)
    {
	    if (InToolUpgrade == null) return "";
	    bool IsMaxed = InCurrentLevel >= InToolUpgrade.MaxLevel;
	    if (IsMaxed) return "";
	    float NextValue = InToolUpgrade.Value * (InCurrentLevel + 1);
	    switch (InToolUpgrade.ToolStat)
	    {
		    case EToolStat.Power: return "+" + InToolUpgrade.Description.Replace("{0}", NextValue.ToString("G"));
		    default: return InToolUpgrade.Description.Replace("{0}", NextValue.ToString("G"));
	    }
    }
    private PlayerData GetPlayerData()
    {
        Data ??= PlayerSaveManager.Instance.Data;
        return Data;
    }
    
    private void SelectTool(ETool InTool, bool IsUnlocked)
    {
	    SelectedTool = InTool;
	    if (IsUnlocked) Data.EquipTool(InTool);
    }
    private void UnlockTool(ETool InTool, int InPrice)
    {
        if (Data.GetMoney() < InPrice) return;
        Data.SubtractMoney(InPrice);
		Data.UnlockTool(InTool);
		Data.EquipTool(InTool);
    }
    private void PurchaseUpgrade(EToolStat InStat, int InPrice)
    {
	    if (Data.GetMoney() < InPrice) return;
        SoundManager.Instance.Play2D(ESound.BuyUpgrade);
        Data.SubtractMoney(InPrice);
		Data.IncrementToolStatLevel(SelectedTool, InStat);
    }
    private void CloseMenu() { UiManager.ChangeUiState(EUi.ToolUpgrades); }
    private void UiStateChanged(EUi InUi, bool RenderState)
    {
        if (InUi != EUi.ToolUpgrades) return;
        IsOpen = RenderState;
        Panel?.Style.PointerEvents = IsOpen ? PointerEvents.All : PointerEvents.None;
    }
}
